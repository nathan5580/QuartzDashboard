<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- NuGet packaging -->
    <PackageId>Dot.QuartzDashboard</PackageId>
    <Version>4.2.0</Version>
    <Authors>n8</Authors>
    <Description>A beautiful, self-contained Quartz.NET scheduler dashboard. Drop into any ASP.NET Core app with two lines of code. View jobs, triggers, history, execution graph, timeline, health, and control the scheduler from a polished SPA. Includes SignalR real-time updates and an embeddable read-only mode.</Description>
    <PackageTags>quartz;quartz.net;dashboard;scheduler;admin;monitoring;realtime;signalr;jobs;triggers;history;visualization;background-jobs;aspnetcore;dotnet</PackageTags>
    <PackageReleaseNotes>v4.2.0 — Security hardening + perf + a11y polish.
• Safer defaults: RequireAuthentication now defaults to true; new RequireCsrfHeader option (default true) blocks cross-site triggering of jobs.
• Defence in depth: X-Content-Type-Options, X-Frame-Options, Referrer-Policy on dashboard responses.
• Perf: GetAllJobs / GetAllTriggers batch trigger-state lookups in parallel (was N round-trips per request).
• Reliability: SignalR bridge now unsubscribes event handlers in StopAsync, preventing handler accumulation across host recycles.
• A11y: prefers-reduced-motion respected on all animations; toast queue announced via aria-live="polite".
• Cleanup: FireRecord properties are init-only; DashboardEventBus internals no longer leak as public; polling fallback timer cleared on pagehide/beforeunload.
• ExportImport: jobs imported as PlaceholderJob now reported back to the caller instead of failing silently.
See CHANGELOG.md for the full list.</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/nathan5580/QuartzDashboard</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nathan5580/QuartzDashboard</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DeterministicSourcePaths>true</DeterministicSourcePaths>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- SourceLink: embed source files into the symbol package -->
  <ItemGroup>
    <EmbeddedFiles Include="**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\QuartzDashboard.Abstractions\QuartzDashboard.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Quartz: floor is what we've tested against (3.18); ceiling locks out unverified 4.x. -->
    <PackageReference Include="Quartz" Version="[3.18.0,4.0.0)" />
    <PackageReference Include="Quartz.Extensions.DependencyInjection" Version="[3.18.0,4.0.0)" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot/**"
                      Exclude="wwwroot/app.js;wwwroot/app.css;wwwroot/charts.js;wwwroot/tailwind.css;wwwroot/src/**;wwwroot/styles/**" />
  </ItemGroup>

  <!-- Regenerate minified assets if source files are newer -->
  <Target Name="MinifyAssets" BeforeTargets="BeforeBuild" Condition="'$(SkipMinify)' != 'true'">
    <Exec Command="node build-assets.mjs" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

</Project>
