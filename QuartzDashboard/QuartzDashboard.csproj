<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- NuGet packaging -->
    <PackageId>Dot.QuartzDashboard</PackageId>
    <Version>4.4.0</Version>
    <Authors>n8</Authors>
    <Description>A beautiful, self-contained Quartz.NET scheduler dashboard. Drop into any ASP.NET Core app with two lines of code. View jobs, triggers, history, execution graph, timeline, health, and control the scheduler from a polished SPA. Includes SignalR real-time updates and an embeddable read-only mode.</Description>
    <PackageTags>quartz;quartz.net;dashboard;scheduler;admin;monitoring;realtime;signalr;jobs;triggers;history;visualization;background-jobs;aspnetcore;dotnet</PackageTags>
    <PackageReleaseNotes>v4.4.0 — Observability, rate limiting, health checks.
• Tracing: OpenTelemetry-compatible Activity spans propagate through listener → event bus → SignalR bridge for end-to-end job execution visibility.
• Rate limiting: configurable per-minute request cap on mutating endpoints (pause/resume/trigger/delete), default on.
• Health check: dashboard status exposed as IHealthCheck so host apps can include it in their own /healthz endpoint.
• Cleanup: *.png screenshots excluded from repository via .gitignore.</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/nathan5580/QuartzDashboard</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nathan5580/QuartzDashboard</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DeterministicSourcePaths>true</DeterministicSourcePaths>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- SourceLink: embed source files into the symbol package -->
  <ItemGroup>
    <EmbeddedFiles Include="**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="QuartzDashboard.Tests" />
    <InternalsVisibleTo Include="QuartzDashboard.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\QuartzDashboard.Abstractions\QuartzDashboard.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Quartz: floor is what we've tested against (3.18); ceiling locks out unverified 4.x. -->
    <PackageReference Include="Quartz" Version="[3.20.0, 4.0.0)" />
    <PackageReference Include="Quartz.Extensions.DependencyInjection" Version="[3.20.0, 4.0.0)" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot/**"
                      Exclude="wwwroot/app.js;wwwroot/app.css;wwwroot/charts.js;wwwroot/tailwind.css;wwwroot/src/**;wwwroot/styles/**" />
  </ItemGroup>

  <!-- Regenerate minified assets if source files are newer -->
  <Target Name="MinifyAssets" BeforeTargets="BeforeBuild" Condition="'$(SkipMinify)' != 'true'">
    <Exec Command="node build-assets.mjs" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

</Project>
